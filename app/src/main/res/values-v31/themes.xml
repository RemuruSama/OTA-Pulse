<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
    On Android 12 and above, this theme will be used. It inherits from a
    Material 3 theme that automatically applies the user's chosen
    system accent colors (Material You).
    -->
    <style name="Theme.OtaUpdater" parent="Theme.OTAPulse">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Apply custom MaterialCardView style to remove outlines -->
        <item name="materialCardViewStyle">@style/Widget.App.MaterialCardView</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>
</resources>
