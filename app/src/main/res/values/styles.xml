<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Widget.App.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>

    <style name="Widget.App.ListPopupWindow" parent="Widget.AppCompat.ListPopupWindow">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>

    <style name="Widget.App.Button.SupportCompact" parent="Widget.Material3.Button">
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="iconSize">18dp</item>
        <item name="android:stateListAnimator">@animator/bounce_animation</item>
    </style>

    <style name="Widget.App.MaterialSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbIcon">@drawable/selector_switch_thumb_icon</item>
        <item name="thumbIconTint">@color/selector_switch_thumb_icon_tint</item>
    </style>

    <style name="DialogFadeAnimation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_fade_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_fade_out</item>
    </style>

    <style name="Theme.App.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowAnimationStyle">@style/DialogFadeAnimation</item>
        <item name="android:windowBlurBehindEnabled" tools:targetApi="31">true</item>
        <item name="android:windowBlurBehindRadius" tools:targetApi="31">16dp</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>

</resources>
