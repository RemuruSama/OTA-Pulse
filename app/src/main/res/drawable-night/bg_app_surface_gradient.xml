<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <!-- Gradient base using container colors -->
            <gradient
                android:angle="315"
                android:startColor="?attr/colorPrimaryContainer"
                android:centerColor="?attr/colorTertiaryContainer"
                android:endColor="?attr/colorSecondaryContainer"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- Soften the gradient by overlaying a transparent surface color -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_overlay" />
        </shape>
    </item>
</layer-list>
