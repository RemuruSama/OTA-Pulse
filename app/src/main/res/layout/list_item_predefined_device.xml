<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="12dp"
    app:strokeWidth="0dp"
    app:strokeColor="@android:color/transparent"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top section: Device Name, Model, and Expand Arrow -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:minHeight="64dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/deviceNameTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    tools:text="Device Name" />

                <TextView
                    android:id="@+id/deviceModelTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Product Model" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/moreOptionsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_more_options"
                android:src="@drawable/ic_more_vert"
                android:padding="12dp"
                android:visibility="gone"
                app:tint="?attr/colorOnSurfaceVariant"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/favoriteButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_mark_favorite"
                android:src="@drawable/ic_favorite_outline"
                android:padding="12dp" />

            <ImageView
                android:id="@+id/expandArrow"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:stateListAnimator="@animator/bounce_animation"
                android:padding="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_down"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Expandable section -->
        <LinearLayout
            android:id="@+id/expandableContentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Android Version Selection -->
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/androidVersionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:flexWrap="wrap"
                app:justifyContent="flex_start" />

            <!-- Region Selection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/selectRegionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_region_variant"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <ImageView
                    android:id="@+id/loadingIndicator"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/loading_dots_animation"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/regionalVariantFlexboxLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:alignItems="flex_start"
                app:flexWrap="wrap"
                app:justifyContent="flex_start" />

            <!-- OTA Details Container (shown only after fetch) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/otaDetailsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                tools:visibility="visible">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvComponentName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="@string/ota_details_title" />

                    <!-- Version Name -->
                    <TextView
                        android:id="@+id/tvVersionName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textStyle="bold"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvComponentName"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="RMX3840_14.0.0.1501(EX01)" />

                    <!-- Details Grid -->
                    <TextView
                        android:id="@+id/labelAndroidVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/label_android_version_colon"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvVersionName" />
                    <TextView
                        android:id="@+id/tvAndroidVersion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="end"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        app:layout_constraintBaseline_toBaselineOf="@+id/labelAndroidVersion"
                        app:layout_constraintStart_toEndOf="@+id/labelAndroidVersion"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="14" />

                    <TextView
                        android:id="@+id/labelOsVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/label_os_version_colon"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/labelAndroidVersion" />
                    <TextView
                        android:id="@+id/tvRealOsVersion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="end"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        app:layout_constraintBaseline_toBaselineOf="@+id/labelOsVersion"
                        app:layout_constraintStart_toEndOf="@+id/labelOsVersion"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="ColorOS 14.0" />

                    <TextView
                        android:id="@+id/labelSecurityPatch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/label_security_patch_colon"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/labelOsVersion" />
                    <TextView
                        android:id="@+id/tvSecurityPatch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="end"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        app:layout_constraintBaseline_toBaselineOf="@+id/labelSecurityPatch"
                        app:layout_constraintStart_toEndOf="@+id/labelSecurityPatch"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="2024-07-05" />

                    <TextView
                        android:id="@+id/labelSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/label_size_colon"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/labelSecurityPatch" />
                    <TextView
                        android:id="@+id/tvSize"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="end"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        app:layout_constraintBaseline_toBaselineOf="@+id/labelSize"
                        app:layout_constraintStart_toEndOf="@+id/labelSize"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="5.9 GB" />

                    <TextView
                        android:id="@+id/labelMd5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/label_md5_colon"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/labelSize" />
                    <TextView
                        android:id="@+id/tvMd5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="end"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        app:layout_constraintBaseline_toBaselineOf="@+id/labelMd5"
                        app:layout_constraintStart_toEndOf="@+id/labelMd5"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="longmd5hashstringgoeshere12345" />

                    <!-- Buttons -->
                    <androidx.constraintlayout.helper.widget.Flow
                        android:id="@+id/buttonFlow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:constraint_referenced_ids="btnChangelog,btnCopyLink"
                        app:flow_horizontalStyle="spread_inside"
                        app:flow_wrapMode="chain"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/labelMd5" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChangelog"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:stateListAnimator="@animator/bounce_animation"
                        android:text="@string/btn_view_changelog"
                        tools:layout_editor_absoluteX="16dp"
                        tools:layout_editor_absoluteY="111dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyLink"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:stateListAnimator="@animator/bounce_animation"
                        android:text="@string/button_copy_link"
                        tools:layout_editor_absoluteX="175dp"
                        tools:layout_editor_absoluteY="111dp" />

                    <!-- Single Download Action Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadOta"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:stateListAnimator="@animator/bounce_animation"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@+id/buttonFlow"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:text="@string/button_download" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/errorCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/errorTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/no_update_found"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorError" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/retryButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:stateListAnimator="@animator/bounce_animation"
                        android:layout_marginTop="8dp"
                        android:text="@string/retry" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
