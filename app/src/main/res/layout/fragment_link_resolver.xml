<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="104dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_header"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="36dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/tv_header_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/link_resolver_header_badge"
                android:textColor="?attr/colorPrimary"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.18"
                android:alpha="0.75"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Cursor blink decoration -->
            <TextView
                android:id="@+id/tv_cursor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cursor_decoration"
                android:textColor="?attr/colorPrimary"
                android:textSize="10sp"
                android:layout_marginStart="6dp"
                android:alpha="0.75"
                app:layout_constraintTop_toTopOf="@id/tv_header_badge"
                app:layout_constraintBottom_toBottomOf="@id/tv_header_badge"
                app:layout_constraintStart_toEndOf="@id/tv_header_badge" />

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/link_resolver_header_title"
                android:textAppearance="?attr/textAppearanceDisplaySmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                android:lineSpacingMultiplier="0.92"
                app:layout_constraintTop_toBottomOf="@id/tv_header_badge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/card_hero_icon" />

            <!-- Accent line under title -->
            <View
                android:id="@+id/view_accent_line"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_accent_line"
                app:layout_constraintTop_toBottomOf="@id/tv_header_title"
                app:layout_constraintStart_toStartOf="@id/tv_header_title"
                app:layout_constraintEnd_toEndOf="@id/tv_header_title" />

            <TextView
                android:id="@+id/tv_header_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/link_resolver_header_subtitle"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintTop_toBottomOf="@id/view_accent_line"
                app:layout_constraintStart_toStartOf="@id/tv_header_title"
                app:layout_constraintEnd_toEndOf="@id/tv_header_title"
                app:layout_constraintBottom_toBottomOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_hero_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:cardCornerRadius="14dp"
                app:cardBackgroundColor="?attr/colorTertiaryContainer"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_header_title"
                app:layout_constraintBottom_toBottomOf="@id/tv_header_title">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_open_external_stroke"
                    android:contentDescription="@string/tools_link_resolver_title"
                    app:tint="?attr/colorOnTertiaryContainer" />
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_resolver_input"
                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_paste_download_check_link"
                app:helperText="@string/helper_paste_ota_link"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:boxCornerRadiusTopStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusBottomEnd="18dp"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_paste_stroke">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_resolver_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="4"
                    android:fontFamily="monospace" />
            </com.google.android.material.textfield.TextInputLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:layout_gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_resolve_link"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/btn_resolve_link"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="27dp" />

                <com.abhinav.otapulse.core.ui.WavyCircularProgressIndicator
                    android:id="@+id/progress_resolve_link"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:elevation="4dp"
                    android:visibility="gone" />
            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_resolver_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tv_resolver_filename"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"
                        tools:text="payload.zip" />

                    <TextView
                        android:id="@+id/tv_resolved_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:textIsSelectable="true"
                        tools:text="https://example.com/file.zip" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_copy_resolved_url"
                            style="@style/Widget.Material3.Button.TonalButton.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/copy"
                            app:icon="@drawable/ic_copy_stroke" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_share_resolved_url"
                            style="@style/Widget.Material3.Button.TonalButton.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/browser_share"
                            app:icon="@drawable/ic_share_stroke" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
