<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerHigh"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none"
    tools:context=".feature.devices.ui.DeviceFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <View
            android:id="@+id/heroBackground"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="?attr/colorSurface"
            app:layout_constraintBottom_toBottomOf="@+id/deviceModelTextView"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/deviceImageContainer"
            android:layout_width="136dp"
            android:layout_height="136dp"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="68dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/deviceImageView"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:padding="4dp"
                android:contentDescription="@string/device_image_content_description"
                android:src="@drawable/ic_deviceimage" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/deviceNameTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="24dp"
            android:gravity="center"
            android:text="@string/device_name_placeholder"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/deviceImageContainer" />

        <TextView
            android:id="@+id/deviceModelTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingBottom="24dp"
            android:text="@string/device_model_placeholder"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/deviceNameTextView" />

        <com.google.android.material.chip.Chip
            android:id="@+id/deviceSupportedTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/device_supported_placeholder"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:clickable="false"
            android:focusable="false"
            style="@style/Widget.Material3.Chip.Suggestion"
            app:chipBackgroundColor="?attr/colorSurface"
            app:chipStrokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/deviceModelTextView" />

        <!-- Divider between hero and hardware section -->
        <View
            android:id="@+id/heroDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:background="?attr/colorOutlineVariant"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/deviceSupportedTextView" />

        <TextView
            android:id="@+id/statsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:text="@string/hardware_info_header"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/heroDivider" />

        <!-- Stats Grid (Using GridLayout for 2 columns) -->
        <GridLayout
            android:id="@+id/statsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:columnOrderPreserved="false"
            android:paddingHorizontal="8dp"
            android:rowCount="3"
            android:useDefaultMargins="true"
            app:layout_constraintTop_toBottomOf="@+id/statsHeader">

            <FrameLayout
                android:id="@+id/ramLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp">
                <include layout="@layout/item_stat_card" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/storageLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp">
                <include layout="@layout/item_stat_card" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/batteryLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp">
                <include layout="@layout/item_stat_card" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/cpuLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp">
                <include layout="@layout/item_stat_card" />
            </FrameLayout>
            
            <FrameLayout
                android:id="@+id/displayLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp">
                <include layout="@layout/item_stat_card" />
            </FrameLayout>
                
             <FrameLayout
                android:id="@+id/socLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp">
                <include layout="@layout/item_stat_card" />
            </FrameLayout>

        </GridLayout>

        <!-- Software Info Header -->
        <TextView
            android:id="@+id/softwareHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:text="@string/software_info_header"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/statsGrid" />

        <!-- Software Info List Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/softwareInfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:paddingBottom="8dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:strokeColor="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@+id/softwareHeader">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/androidVersionLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include layout="@layout/device_info_item" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/osVersionLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include layout="@layout/device_info_item" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/otaVersionLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include layout="@layout/device_info_item" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/incrementalOsVersionLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include layout="@layout/device_info_item" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/kernelVersionLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include layout="@layout/device_info_item" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/securityPatchLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include layout="@layout/device_info_item" />
                </FrameLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
